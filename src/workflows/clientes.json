    {
      "parameters": {
        "jsCode": "const id = $json.params.id;\n\nconst isUuid =\n    typeof id === 'string' &&\n    /^[0-9a-fA-F]{8}\\b-[0-9a-fA-F]{4}\\b-[0-9a-fA-F]{4}\\b-[0-9a-fA-F]{4}\\b-[0-9a-fA-F]{12}$/.test(id);\n\nreturn { id, valido: isUuid }"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        448
      ],
      "id": "97569c49-ea37-4e0c-bdab-df3f92a9912b",
      "name": "validação UUID"
    },
    {
      "parameters": {
        "jsCode": "const { nome, email, telefone } = $input.first().json.body;\n\nconst erros = [];\n\nif (!nome || nome.trim().length < 2) erros.push(\"nome é obrigatório\");\nif (!email || !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) erros.push(\"email inválido\");\nif (!telefone || telefone.trim().length < 8) erros.push(\"telefone é obrigatório\");\nelse if (!/^\\([1-9]{2}\\) (?:[2-8]|9[0-9])[0-9]{3}\\-[0-9]{4}$/.test(telefone)) erros.push(\"telefone inválido\")\n\nreturn [{ json: { nome, email, telefone, erros, valido: erros.length === 0 } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
